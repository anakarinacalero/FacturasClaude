# ============================================================
# ExamenApi — Variables de entorno
# ============================================================
# INSTRUCCIONES:
#   1. Copia este archivo: cp .env.example .env
#   2. Llena los valores reales en tu .env local.
#   3. NUNCA commitees .env (ya está en .gitignore).
#   4. En producción usa el gestor de secretos del servidor
#      (Azure Key Vault, AWS Secrets Manager, etc.), no .env.
#
# Para desarrollo local se recomienda dotnet user-secrets
# en lugar de .env. Ver CLAUDE.md §11 para los comandos.
# ============================================================

# ── Entorno de ejecución ─────────────────────────────────────
# Valores válidos: Development | Staging | Production
ASPNETCORE_ENVIRONMENT=Development

# Puerto de la API (opcional, por defecto 5000/5001)
ASPNETCORE_URLS=http://localhost:5000;https://localhost:5001

# ── Base de datos — SQL Server ────────────────────────────────
# Formato: Server={host};Database={nombre};User Id={user};Password={pass};TrustServerCertificate=True;
# Ejemplo local con autenticación integrada (Windows):
#   Server=localhost;Database=ExamenApi;Trusted_Connection=True;TrustServerCertificate=True;
# Ejemplo con usuario/contraseña:
#   Server=localhost,1433;Database=ExamenApi;User Id=sa;Password=TuPassword!;TrustServerCertificate=True;
CONNECTIONSTRINGS__DEFAULT=Server=localhost;Database=ExamenApi;User Id=sa;Password=CHANGE_ME;TrustServerCertificate=True;

# ── Anthropic API (Claude) ────────────────────────────────────
# Obtén tu API key en: https://console.anthropic.com/
# Formato: sk-ant-api03-...
ANTHROPIC__APIKEY=sk-ant-api03-CHANGE_ME

# Modelo a usar. Consulta modelos disponibles en la documentación de Anthropic.
# Ejemplo: claude-opus-4-6 | claude-sonnet-4-6 | claude-haiku-4-5-20251001
ANTHROPIC__MODEL=claude-sonnet-4-6

# Máximo de tokens por respuesta de Claude
ANTHROPIC__MAXTOKENS=1024

# URL base de la API de Anthropic (no cambiar salvo proxy corporativo)
ANTHROPIC__BASEURL=https://api.anthropic.com

# ── JWT (cuando se implemente autenticación) ──────────────────
# Genera una clave segura: openssl rand -base64 64
JWT__KEY=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_KEY_MIN_32_CHARS
JWT__ISSUER=ExamenApi
JWT__AUDIENCE=ExamenApi.Clients
JWT__EXPIRYHOURS=1

# ── Logging ───────────────────────────────────────────────────
# Valores válidos: Trace | Debug | Information | Warning | Error | Critical | None
LOGGING__LOGLEVEL__DEFAULT=Information
LOGGING__LOGLEVEL__MICROSOFT_ASPNETCORE=Warning

# ── Otros (agregar según se necesiten) ───────────────────────
# Ejemplo de configuración adicional:
# SMTP__HOST=smtp.example.com
# SMTP__PORT=587
# SMTP__USER=noreply@example.com
# SMTP__PASSWORD=CHANGE_ME
